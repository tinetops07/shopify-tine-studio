{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {string} [icon_position] - The search icon position ('left' or 'right').
  @param {string} [image_search_position] - Image search icon position ('none', 'left', or 'right').
  @param {string} [bar_text] - Text displayed inside the search bar.
  @param {string} [border_color] - Search bar border color.
  @param {number} [border_width] - Search bar border width in pixels.
  @param {number} [border_radius] - Search bar border radius in pixels.
  @param {string} [text_color] - Search bar and image-search panel text color.

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% unless style == 'none' %}
  <script src="{{ 'search-image-popover.js' | asset_url }}" type="module"></script>
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text search-action--icon-{{ icon_position | default: 'left' }}{% endif %}{% if image_search_position != blank and image_search_position != 'none' %} search-action--image-{{ image_search_position }}{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
    {% if display_style == 'text' %}style="--search-border-color: {{ border_color | default: 'currentColor' }}; --search-border-width: {{ border_width | default: 1 }}px; --search-border-radius: {{ border_radius | default: 8 }}px; --search-text-color: {{ text_color | default: '#111111' }};"{% endif %}
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="search-action__label {% if display_style == 'icon' %}hidden{% endif %}">
        {{ bar_text | default: 'Search' }}
      </span>

      <span class="search-action__icon svg-wrapper {% if display_style == 'text' %}search-action__icon--bar{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
    {% if image_search_position != blank and image_search_position != 'none' and display_style == 'text' %}
      <search-image-popover>
        <details class="search-action__image-search">
        <summary class="search-action__image-button" title="Search by image">
          <span class="visually-hidden">Search by image</span>
          <span class="svg-wrapper">
            {{ 'icon-image-search.svg' | inline_asset_content }}
          </span>
        </summary>
        <div class="search-action__image-panel">
          <div class="search-action__image-panel-header">
            <span class="svg-wrapper">
              {{ 'icon-image-search.svg' | inline_asset_content }}
            </span>
            <div class="search-action__image-panel-heading">Search By Image</div>
            <button
              type="button"
              class="button-unstyled search-action__image-close"
              aria-label="Close image search"
              data-image-search-toggle
            >
              <span class="svg-wrapper">
                {{ 'icon-caret.svg' | inline_asset_content }}
              </span>
            </button>
          </div>
          <div class="search-action__dropzone" data-image-dropzone>
            <div class="search-action__upload-empty" data-image-upload-empty>
              <span class="search-action__dropzone-copy">Drag an image here or</span>
              <label class="search-action__upload-button">
                <span class="svg-wrapper">
                  {{ 'icon-image-search.svg' | inline_asset_content }}
                </span>
                <span>Upload photo</span>
                <input type="file" accept="image/*" class="visually-hidden" data-image-file-input>
              </label>
            </div>
            <div class="search-action__uploading" data-image-uploading hidden>Uploading...</div>
            <div class="search-action__image-preview" data-image-preview hidden>
              <button type="button" class="button-unstyled search-action__preview-close" data-image-preview-close aria-label="Remove image">
                <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
              </button>
              <img data-image-preview-image alt="Uploaded image preview" width="640" height="480">
            </div>
          </div>
          <div class="search-action__image-divider"><span>OR</span></div>
          <label class="search-action__image-url">
            <span class="svg-wrapper">
              {{ 'icon-link.svg' | inline_asset_content }}
            </span>
            <input type="url" placeholder="Paste an image link" aria-label="Paste an image link">
          </label>
          <div class="search-action__examples-heading" data-image-examples-heading>You can try one of these styles below</div>
          <div class="search-action__examples" data-image-examples>
            {% for product in collections.all.products limit: 4 %}
              {% if product.featured_image %}
                <div class="search-action__example">
                  <img
                    src="{{ product.featured_image | image_url: width: 320 }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                    width="160"
                    height="220"
                  >
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="search-action__results-heading" data-image-results-heading hidden>Demo visual matches</div>
          <div class="search-action__examples" data-image-results hidden>
            {% for product in collections.all.products limit: 4 %}
              {% if product.featured_image %}
                <a class="search-action__example" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                  <img
                    src="{{ product.featured_image | image_url: width: 320 }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                    width="160"
                    height="220"
                  >
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        </details>
      </search-image-popover>
    {% endif %}
  </search-button>
{% endunless %}

{% stylesheet %}
  .search-action {
    display: flex;
  }

  .search-action--text {
    border: var(--search-border-width) solid var(--search-border-color);
    border-radius: var(--search-border-radius);
    position: relative;
  }

  .search-action--text > button {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    padding-inline: var(--padding-sm);
  }

  .search-action--text .search-action__icon--bar {
    order: -1;
  }

  .search-action--text.search-action--icon-right .search-action__icon--bar {
    order: 1;
  }

  .search-action__image-button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    min-height: 2.75rem;
    cursor: pointer;
    color: currentColor;
  }

  .search-action--image-right .search-action__image-button {
    padding-inline-end: 0.35rem;
  }

  .search-action__image-search {
    position: relative;
  }

  .search-action__image-search summary {
    list-style: none;
  }

  .search-action__image-search summary::-webkit-details-marker {
    display: none;
  }

  .search-action__image-panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + var(--gap-sm));
    right: 0;
    display: grid;
    gap: var(--gap-sm);
    width: min(32rem, calc(100vw - 1.5rem));
    padding: var(--padding-sm);
    color: var(--search-text-color, #111111);
    background: var(--color-background);
    border: 1px solid color-mix(in srgb, var(--search-text-color, #111111) 12%, transparent);
    border-radius: 1.5rem;
    box-shadow: var(--shadow-popover);
  }

  .search-action__image-panel-header {
    display: grid;
    grid-template-columns: 2rem 1fr 2rem;
    align-items: center;
    min-height: 3rem;
    padding-inline: var(--padding-sm);
  }

  .search-action__image-panel-header > .svg-wrapper {
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    color: color-mix(in srgb, var(--search-text-color, #111111) 35%, transparent);
  }

  .search-action__image-panel-heading {
    font-size: 1.25rem;
    font-weight: 600;
    text-align: center;
  }

  .search-action__image-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
  }

  .search-action__image-close .svg-wrapper {
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
    transform: rotate(180deg);
    transition: transform 150ms ease;
  }

  .search-action__image-search:not([open]) .search-action__image-close .svg-wrapper {
    transform: rotate(0deg);
  }

  .search-action__dropzone {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--gap-xs);
    justify-items: center;
    align-items: center;
    min-height: 10rem;
    padding: var(--padding-lg);
    text-align: center;
    cursor: pointer;
    background: color-mix(in srgb, var(--search-text-color, #111111) 2.5%, transparent);
    border: 2px dashed color-mix(in srgb, var(--search-text-color, #111111) 10%, transparent);
    border-radius: 0.75rem;
  }

  .search-action__dropzone--dragging {
    background: color-mix(in srgb, var(--search-text-color, #111111) 8%, transparent);
    border-color: var(--search-text-color, #111111);
  }

  .search-action__dropzone--preview {
    display: block;
    min-height: 0;
    padding: 0;
    background: transparent;
    border: 0;
  }

  .search-action__dropzone--preview .search-action__upload-empty,
  .search-action__dropzone--preview .search-action__uploading {
    display: none;
  }

  .search-action__upload-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs);
    width: 100%;
    min-height: 4rem;
  }

  .search-action__upload-button {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    padding: 0.6rem 1rem;
    font-weight: 600;
    border: 2px solid currentColor;
    border-radius: 999px;
    white-space: nowrap;
    cursor: pointer;
  }

  .search-action__upload-button input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .search-action__uploading {
    min-height: 4rem;
    align-content: center;
    font-weight: 600;
  }

  .search-action__upload-button .svg-wrapper {
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
  }

  .search-action__image-divider {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    color: var(--color-foreground);
    font-weight: 600;
    text-align: center;
  }

  .search-action__image-divider::before,
  .search-action__image-divider::after {
    flex: 1;
    height: 1px;
    content: '';
    background: rgb(var(--color-foreground-rgb) / 0.15);
  }

  .search-action__image-url {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    padding: 0.7rem 1rem;
    background: color-mix(in srgb, var(--search-text-color, #111111) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--search-text-color, #111111) 12%, transparent);
    border-radius: 999px;
  }

  .search-action__image-url > .svg-wrapper {
    display: flex;
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    color: color-mix(in srgb, var(--search-text-color, #111111) 65%, transparent);
  }

  .search-action__image-url input {
    min-width: 0;
    width: 100%;
    padding: 0;
    color: var(--search-text-color, #111111);
    background: transparent;
    border: 0;
    outline: 0;
  }

  .search-action__examples-heading {
    margin-block-start: var(--padding-xs);
    font-size: 0.95rem;
    text-align: center;
  }

  .search-action__results-heading {
    margin-block-start: var(--padding-xs);
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
  }

  .search-action__examples {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-sm);
  }

  .search-action__example {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: color-mix(in srgb, var(--search-text-color, #111111) 5%, transparent);
  }

  .search-action__example img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-action__image-preview {
    position: relative;
    width: 100%;
    min-height: 18rem;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .search-action__image-preview img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 28rem;
    object-fit: contain;
    background: rgb(0 0 0 / 0.08);
  }

  .search-action__preview-close {
    position: absolute;
    z-index: 1;
    top: var(--padding-sm);
    right: var(--padding-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-background);
    border-radius: 50%;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
  }

  .search-action__preview-close .svg-wrapper {
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
  }

  .search-action__upload-new {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs);
    width: max-content;
    min-height: 2.75rem;
    margin-inline: auto;
    padding: 0.6rem 1rem;
    font-weight: 600;
    border: 2px solid currentColor;
    border-radius: 999px;
  }

  .search-action__upload-new .svg-wrapper {
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
  }

  .search-action--image-left .search-action__image-button {
    order: -1;
  }

  .search-action__image-button .svg-wrapper {
    display: flex;
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
  }

  @media screen and (max-width: 749px) {
    .search-action__image-panel {
      position: fixed;
      top: 50%;
      left: 50%;
      right: auto;
      transform: translate(-50%, -50%);
    }

    .search-action__dropzone {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }
{% endstylesheet %}
