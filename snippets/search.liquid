{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {string} [bar_style] - The search bar border and icon position style.
  @param {boolean} [show_image_search] - Whether to show the image search picker.

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% unless style == 'none' %}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text search-action--{{ bar_style | default: 'none-left' }}{% endif %}{% if show_image_search %} search-action--image-search{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="search-action__label {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.search' | t }}
      </span>

      <span class="search-action__icon svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
    {% if show_image_search and display_style == 'text' %}
      <label class="search-action__image-button" title="Search by image">
        <span class="visually-hidden">Search by image</span>
        <span class="svg-wrapper">
          {{ 'icon-image-search.svg' | inline_asset_content }}
        </span>
        <input
          type="file"
          accept="image/*"
          class="visually-hidden"
          aria-label="Search by image"
          onchange="this.closest('search-button').classList.toggle('search-action--image-selected', this.files.length > 0)"
        >
      </label>
    {% endif %}
  </search-button>
{% endunless %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  .search-action--text {
    border: var(--search-border-width) solid transparent;
    border-radius: 0;
  }

  .search-action--text:is(.search-action--sharp-left, .search-action--sharp-right) {
    border-color: currentColor;
  }

  .search-action--text:is(.search-action--rounded-left, .search-action--rounded-right) {
    border-color: currentColor;
    border-radius: var(--search-border-radius);
  }

  .search-action--text > button {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    padding-inline: var(--padding-sm);
  }

  .search-action--text.search-action--sharp-left > button,
  .search-action--text.search-action--rounded-left > button {
    flex-direction: row-reverse;
  }

  .search-action__image-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    cursor: pointer;
    border-inline-start: var(--search-border-width) solid currentColor;
  }

  .search-action__image-button .svg-wrapper {
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
  }

  .search-action--image-selected .search-action__image-button {
    color: var(--color-primary-button-text);
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }
{% endstylesheet %}
