{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {string} [icon_position] - The search icon position ('left' or 'right').
  @param {string} [image_search_position] - Image search icon position ('none', 'left', or 'right').
  @param {string} [bar_text] - Text displayed inside the search bar.
  @param {string} [border_color] - Search bar border color.
  @param {number} [border_width] - Search bar border width in pixels.
  @param {number} [border_radius] - Search bar border radius in pixels.

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% unless style == 'none' %}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text search-action--icon-{{ icon_position | default: 'left' }}{% endif %}{% if image_search_position != blank and image_search_position != 'none' %} search-action--image-{{ image_search_position }}{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
    {% if display_style == 'text' %}style="--search-border-color: {{ border_color | default: 'currentColor' }}; --search-border-width: {{ border_width | default: 1 }}px; --search-border-radius: {{ border_radius | default: 8 }}px;"{% endif %}
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="search-action__label {% if display_style == 'icon' %}hidden{% endif %}">
        {{ bar_text | default: 'Search' }}
      </span>

      <span class="search-action__icon svg-wrapper {% if display_style == 'text' %}search-action__icon--bar{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
    {% if image_search_position != blank and image_search_position != 'none' and display_style == 'text' %}
      <details class="search-action__image-search">
        <summary class="search-action__image-button" title="Search by image">
          <span class="visually-hidden">Search by image</span>
          <span class="svg-wrapper">
            {{ 'icon-image-search.svg' | inline_asset_content }}
          </span>
        </summary>
        <div class="search-action__image-panel">
          <div class="search-action__image-panel-header">
            <span class="svg-wrapper">
              {{ 'icon-image-search.svg' | inline_asset_content }}
            </span>
            <div class="search-action__image-panel-heading">Search By Image</div>
            <button
              type="button"
              class="button-unstyled search-action__image-close"
              aria-label="Close image search"
              onclick="this.closest('details').removeAttribute('open')"
            >
              <span class="svg-wrapper">
                {{ 'icon-caret.svg' | inline_asset_content }}
              </span>
            </button>
          </div>
          <label class="search-action__dropzone">
            <span class="search-action__dropzone-copy">Drag an image here or</span>
            <span class="search-action__upload-button">
              <span class="svg-wrapper">
                {{ 'icon-image-search.svg' | inline_asset_content }}
              </span>
              Upload photo
            </span>
            <input type="file" accept="image/*" class="visually-hidden">
          </label>
          <div class="search-action__image-divider"><span>OR</span></div>
          <label class="search-action__image-url">
            <span class="svg-wrapper">
              {{ 'icon-link.svg' | inline_asset_content }}
            </span>
            <input type="url" placeholder="Paste an image link" aria-label="Paste an image link">
          </label>
          <div class="search-action__examples-heading">You can try one of these styles below</div>
          <div class="search-action__examples">
            {% for product in collections.all.products limit: 4 %}
              {% if product.featured_image %}
                <div class="search-action__example">
                  <img
                    src="{{ product.featured_image | image_url: width: 320 }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                    width="160"
                    height="220"
                  >
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </details>
    {% endif %}
  </search-button>
{% endunless %}

{% stylesheet %}
  .search-action {
    display: flex;
  }

  .search-action--text {
    border: var(--search-border-width) solid var(--search-border-color);
    border-radius: var(--search-border-radius);
    position: relative;
  }

  .search-action--text > button {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    padding-inline: var(--padding-sm);
  }

  .search-action--text .search-action__icon--bar {
    order: -1;
  }

  .search-action--text.search-action--icon-right .search-action__icon--bar {
    order: 1;
  }

  .search-action__image-button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 2.75rem;
    width: 2.75rem;
    min-height: 2.75rem;
    cursor: pointer;
    color: currentColor;
  }

  .search-action__image-search {
    position: relative;
  }

  .search-action__image-search summary {
    list-style: none;
  }

  .search-action__image-search summary::-webkit-details-marker {
    display: none;
  }

  .search-action__image-panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + var(--gap-sm));
    right: 0;
    display: grid;
    gap: var(--gap-sm);
    width: min(32rem, calc(100vw - 1.5rem));
    padding: var(--padding-sm);
    color: var(--color-foreground);
    background: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 1.5rem;
    box-shadow: var(--shadow-popover);
  }

  .search-action__image-panel-header {
    display: grid;
    grid-template-columns: 2rem 1fr 2rem;
    align-items: center;
    min-height: 3rem;
    padding-inline: var(--padding-sm);
  }

  .search-action__image-panel-header > .svg-wrapper {
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .search-action__image-panel-heading {
    font-size: 1.25rem;
    font-weight: 600;
    text-align: center;
  }

  .search-action__image-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
  }

  .search-action__image-close .svg-wrapper {
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
    transform: rotate(180deg);
  }

  .search-action__dropzone {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--gap-xs);
    justify-items: center;
    align-items: center;
    min-height: 10rem;
    padding: var(--padding-lg);
    text-align: center;
    cursor: pointer;
    background: rgb(var(--color-foreground-rgb) / 0.025);
    border: 2px dashed rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 0.75rem;
  }

  .search-action__upload-button {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    padding: 0.6rem 1rem;
    font-weight: 600;
    border: 2px solid currentColor;
    border-radius: 999px;
  }

  .search-action__upload-button .svg-wrapper {
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
  }

  .search-action__image-divider {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    color: var(--color-foreground);
    font-weight: 600;
    text-align: center;
  }

  .search-action__image-divider::before,
  .search-action__image-divider::after {
    flex: 1;
    height: 1px;
    content: '';
    background: rgb(var(--color-foreground-rgb) / 0.15);
  }

  .search-action__image-url {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    padding: 0.7rem 1rem;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 999px;
  }

  .search-action__image-url > .svg-wrapper {
    display: flex;
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .search-action__image-url input {
    min-width: 0;
    width: 100%;
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    outline: 0;
  }

  .search-action__examples-heading {
    margin-block-start: var(--padding-xs);
    font-size: 0.95rem;
    text-align: center;
  }

  .search-action__examples {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-sm);
  }

  .search-action__example {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .search-action__example img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-action--image-left .search-action__image-button {
    order: -1;
  }

  .search-action__image-button .svg-wrapper {
    display: flex;
    flex: 0 0 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
  }

  @media screen and (max-width: 749px) {
    .search-action__image-panel {
      position: fixed;
      top: 50%;
      left: 50%;
      right: auto;
      transform: translate(-50%, -50%);
    }

    .search-action__dropzone {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }
{% endstylesheet %}
